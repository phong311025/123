rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'tuanphong.workcontact@gmail.com' ||
        (request.auth.token.keys().hasAll(['email_verified']) && request.auth.token.email_verified == true && request.auth.token.email == 'tuanphong.workcontact@gmail.com')
      );
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isDeptAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection endpoint required by Firebase Skill
    match /test/{docId} {
      allow read: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || isDeptAdmin());
      allow create: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Member profiles
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isDeptAdmin();
    }

    // Weekly news and bulletin items
    match /newsItems/{newsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isDeptAdmin();
    }

    // Events
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isDeptAdmin();
    }

    // Communication Plans
    match /communicationPlans/{planId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isDeptAdmin();
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin() || isDeptAdmin();
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        isDeptAdmin() || 
        (resource.data.assigneeIds is list && request.auth.uid in resource.data.assigneeIds) ||
        resource.data.reviewerId == request.auth.uid
      );

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
      }
    }

    // Performance and contribution evaluations
    match /evaluations/{evalId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isDeptAdmin();
    }

    // Security & Operational Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isDeptAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit records
    }

    // Global System Settings
    match /systemSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Custom Fields definition
    match /customFields/{fieldId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
